{
  "name": "irissakura.github.io",
  "version": "1.0.0",
  "description": "IrisSakura 的工程与项目管理、Unity 游戏框架及作品个人站。",
  "scripts": {
    "generate": "node scripts/generate-site.mjs",
    "build": "npm run generate && npm run clean && tsc",
    "test": "npm run test:unit && npm run test:site",
    "test:unit": "node --test tests/*.test.mjs",
    "test:json": "node scripts/verify-json.mjs",
    "test:brand": "node scripts/verify-brand.mjs",
    "test:site": "node scripts/verify-site.mjs",
    "test:evidence-authorities": "node scripts/verify-evidence-chain-authorities.mjs",
    "test:smoke": "node tests/browser-smoke.mjs",
    "journal:import": "node scripts/import-journal-export.mjs",
    "journal:check": "node scripts/import-journal-export.mjs --check",
    "engineering:import": "node scripts/import-engineering-export.mjs",
    "engineering:check": "node scripts/import-engineering-export.mjs --check",
    "consumer:export": "node scripts/export-consumer-projection.mjs",
    "consumer:import": "node scripts/import-consumer-projection.mjs",
    "consumer:check": "node scripts/import-consumer-projection.mjs --check",
    "package:site": "node scripts/prepare-pages.mjs",
    "clean": "node scripts/clean-generated.mjs",
    "check": "npm run test:json && npm run test:evidence-authorities && npm run build && npm run test:brand && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrisSakura/irissakura.github.io.git"
  },
  "keywords": [
    "Unity",
    "game-development",
    "Sakura-Framework",
    "portfolio"
  ],
  "author": "IrisSakura",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "marked": "^18.0.7",
    "sanitize-html": "^2.17.6"
  },
  "bugs": {
    "url": "https://github.com/IrisSakura/irissakura.github.io/issues"
  },
  "homepage": "https://irissakura.github.io/",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "typescript": "^5.9.3"
  }
}
